{
  "name": "sessionswap",
  "version": "1.3.0",
  "author": "Faturahman Alfareza",
  "main": "dist/background.js",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/chrome": "^0.0.323",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "esbuild": "^0.25.4",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "web-ext": "^8.7.0"
  },
  "description": "Browser extension for switching sessions",
  "keywords": [
    "extension",
    "session",
    "switcher"
  ],
  "license": "MIT",
  "scripts": {
    "lint": "eslint src --ext .ts,.js --fix",
    "lint:check": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "format": "bunx prettier . --write",
    "format:check": "bunx prettier . --check",
    "build:firefox": "bun build/build.ts firefox",
    "build:chrome": "bun build/build.ts chrome",
    "dev:firefox": "bun run build:firefox && web-ext run --source-dir=dist",
    "dev:chrome": "bun run build:chrome && web-ext run --source-dir=dist",
    "clean": "rm -rf dist",
    "test": "bun test",
    "prepare": "husky"
  },
  "type": "module",
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  }
}
